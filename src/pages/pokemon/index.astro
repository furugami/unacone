---
// 図鑑一覧ページ（/pokemon/）。getCollection() で全ポケモンデータを取得して並べるだけの、
// 一覧表示に特化したページ。
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ROLE_LABELS, ROLE_COLOR_VARS, ATTACK_TYPE_LABELS } from '../../lib/pokemon';
import { withBase } from '../../lib/url';

const pokemonList = await getCollection('pokemon-jp');
---

<Layout title="図鑑">
	<h1>ポケモン図鑑</h1>
	<ul class="pokemon-grid">
		{
			pokemonList.map((p) => (
				<li>
					<a href={withBase(`/pokemon/${p.data.slug}/`)}>
						{p.data.icon && <img src={p.data.icon} alt="" class="icon" />}
						<span class="badges">
							<span
								class="role-badge"
								style={`background: var(${ROLE_COLOR_VARS[p.data.role]})`}
							>
								{ROLE_LABELS[p.data.role]}
							</span>
							{p.data.attack_type && (
								<span class="attack-type-badge">{ATTACK_TYPE_LABELS[p.data.attack_type]}</span>
							)}
						</span>
						<span class="name">{p.data.name_ja}</span>
					</a>
				</li>
			))
		}
	</ul>
</Layout>

<style>
	.pokemon-grid {
		list-style: none;
		margin: 24px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: 12px;
	}

	.pokemon-grid a {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 16px;
		background: var(--surface);
		border-radius: var(--radius);
		text-decoration: none;
		box-shadow: 0 1px 2px rgba(27, 34, 51, 0.08);
	}

	.icon {
		width: 56px;
		height: 56px;
		object-fit: contain;
		align-self: center;
	}

	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
	}

	.role-badge,
	.attack-type-badge {
		padding: 2px 10px;
		border-radius: 999px;
		font-size: 0.75rem;
		color: #fff;
	}

	.role-badge {
		align-self: flex-start;
	}

	.attack-type-badge {
		background: var(--ink-soft);
	}

	.name {
		font-family: var(--font-heading);
		font-weight: 700;
	}
</style>
