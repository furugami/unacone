---
// ポケモン個別ページ（/pokemon/zeraora/ のような動的ページ）。
// ファイル名の [slug] が可変部分になる。
//
// 静的サイト（SSG）では「どんなURLが存在するか」を事前に全部書き出しておく必要があるため、
// getStaticPaths() という特別な関数で「有り得るslugの一覧」をAstroに教える。
// ここではポケモン全件ぶんのパスを作っている。
import Layout from '../../layouts/Layout.astro';
import AbilityPentagon from '../../components/AbilityPentagon.astro';
import FaqSection from '../../components/FaqSection.astro';
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import {
	ROLE_LABELS,
	ROLE_COLOR_VARS,
	ATTACK_TYPE_LABELS,
	DIFFICULTY_LABELS,
	MOVE_SECTIONS,
	MOVE_LABEL_BY_KEY,
	moveKeyForChoice,
} from '../../lib/pokemon';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
	const pokemonList = await getCollection('pokemon-jp');
	return pokemonList.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const {
	name_ja,
	icon,
	role,
	attack_type,
	difficulty,
	abilities,
	moves,
	builds,
	usage_memo,
	counter_memo,
	commentary_beginner,
	commentary_intermediate,
	commentary_advanced,
	commentary_videos,
} = entry.data;

// 立ち回り解説（難易度別3本）。設定されているものだけアコーディオンとして表示する。
const commentarySections = [
	{ key: 'beginner', label: '初級者向け', markdown: commentary_beginner },
	{ key: 'intermediate', label: '中級者向け', markdown: commentary_intermediate },
	{ key: 'advanced', label: '上級者向け', markdown: commentary_advanced },
].filter((s): s is typeof s & { markdown: string } => Boolean(s.markdown));

// YouTubeのURLから埋め込み用の動画IDを取り出す（watch?v=形式・youtu.be形式の両方に対応）。
function extractYoutubeId(url: string): string | null {
	try {
		const u = new URL(url);
		if (u.hostname.includes('youtu.be')) return u.pathname.slice(1) || null;
		if (u.hostname.includes('youtube.com')) return u.searchParams.get('v');
		return null;
	} catch {
		return null;
	}
}

// abilitiesは各項目が任意入力のため、5項目すべて揃っている場合のみレーダーチャートを表示する
// （一部だけ入力された状態だとAbilityPentagonが数値前提の計算をするため描画できない）。
const hasFullAbilities =
	abilities !== undefined &&
	abilities.combat !== undefined &&
	abilities.durability !== undefined &&
	abilities.mobility !== undefined &&
	abilities.scoring !== undefined &&
	abilities.support !== undefined;

// movesオブジェクトのうち、実際に値が入っている項目だけを表示順に並べる
const moveEntries = moves
	? MOVE_SECTIONS.filter((section) => moves[section.key]).map((section) => ({
			...section,
			data: moves[section.key]!,
		}))
	: [];

// おすすめビルドの「もちもの」「バトルアイテム」は、もちもの/バトルアイテム図鑑の
// slugを指しているので、実際のデータ（名前・アイコン・詳細ページへのリンク）に解決する。
const allHeldItems = await getCollection('held-items');
const heldItemMap = new Map(allHeldItems.map((i) => [i.data.slug, i.data]));
const battleItemMap = new Map((await getCollection('battle-items')).map((i) => [i.data.slug, i.data]));

// このポケモンを対象にしているFAQだけを抽出（faqs側が対象を持つ設計。
// src/content.config.tsの「faqs」コレクション参照）。
const relatedFaqs = (await getCollection('faqs')).filter(
	(f) => f.data.target_pokemon === entry.data.slug
);

// ビルドのわざ1/わざ2選択も、moves内の実データ（表示名・アンカーリンク先）に解決する。
function resolveMoveChoice(baseKey: 'move1' | 'move2', choice: 'base' | 'upgrade_a' | 'upgrade_b' | undefined) {
	const key = moveKeyForChoice(baseKey, choice);
	if (!key || !moves?.[key]) return null;
	return { key, label: MOVE_LABEL_BY_KEY[key], name: moves[key]!.name, icon: moves[key]!.icon };
}

const resolvedBuilds = (builds ?? []).map((build) => ({
	...build,
	heldItemDetails: (build.held_items ?? []).map((slug) => ({ slug, item: heldItemMap.get(slug) })),
	otherRecommendedHeldItemDetails: (build.other_recommended_held_items ?? []).map((slug) => ({
		slug,
		item: heldItemMap.get(slug),
	})),
	battleItemDetail: { slug: build.battle_item, item: battleItemMap.get(build.battle_item) },
	move1Selection: resolveMoveChoice('move1', build.move1_choice),
	move2Selection: resolveMoveChoice('move2', build.move2_choice),
}));
---

<Layout title={name_ja}>
	<div class="hero-row">
		<div class="hero-left">
			{icon && <img src={icon} alt="" class="pokemon-icon" />}
			<h1>{name_ja}</h1>
			<div class="badge-row">
				<span class="role-badge" style={`background: var(${ROLE_COLOR_VARS[role]})`}>
					{ROLE_LABELS[role]}
				</span>
				{attack_type && <span class="attack-type-badge">{ATTACK_TYPE_LABELS[attack_type]}</span>}
				{difficulty && <span class="difficulty-badge">{DIFFICULTY_LABELS[difficulty]}</span>}
			</div>
		</div>
		{
			hasFullAbilities && (
				<div class="hero-right">
					<AbilityPentagon
						abilities={{
							combat: abilities!.combat!,
							durability: abilities!.durability!,
							mobility: abilities!.mobility!,
							scoring: abilities!.scoring!,
							support: abilities!.support!,
						}}
					/>
				</div>
			)
		}
	</div>

	{
		resolvedBuilds.length > 0 && (
			<section>
				<h2>おすすめビルド</h2>
				{resolvedBuilds.map((build) => (
					<article class="build-card">
						<h3>{build.title}</h3>
						{
							(build.move1Selection || build.move2Selection) && (
								<div class="items-row">
									<span class="field-label">わざ</span>
									<div class="chip-group">
										{build.move1Selection && (
											<a href={`#move-${build.move1Selection.key}`} class="item-chip">
												{build.move1Selection.icon && (
													<img src={build.move1Selection.icon} alt="" class="chip-icon" />
												)}
												{build.move1Selection.name}
											</a>
										)}
										{build.move2Selection && (
											<a href={`#move-${build.move2Selection.key}`} class="item-chip">
												{build.move2Selection.icon && (
													<img src={build.move2Selection.icon} alt="" class="chip-icon" />
												)}
												{build.move2Selection.name}
											</a>
										)}
									</div>
								</div>
							)
						}
						<div class="items-row">
							<span class="field-label">バトルアイテム</span>
							<div class="chip-group">
								{build.battleItemDetail.item ? (
									<a href={withBase(`/battle-items/${build.battleItemDetail.slug}/`)} class="item-chip">
										{build.battleItemDetail.item.icon && (
											<img src={build.battleItemDetail.item.icon} alt="" class="chip-icon" />
										)}
										{build.battleItemDetail.item.name_ja}
									</a>
								) : (
									<span class="item-chip missing">{build.battleItemDetail.slug}</span>
								)}
							</div>
						</div>
						<div class="items-row">
							<span class="field-label">もちもの</span>
							<div class="chip-group">
								{build.heldItemDetails.map(({ slug, item }) =>
									item ? (
										<a href={withBase(`/held-items/${slug}/`)} class="item-chip">
											{item.icon && <img src={item.icon} alt="" class="chip-icon" />}
											{item.name_ja}
										</a>
									) : (
										<span class="item-chip missing">{slug}</span>
									)
								)}
							</div>
						</div>
						{
							build.otherRecommendedHeldItemDetails.length > 0 && (
								<div class="items-row">
									<span class="field-label">その他のもちもの候補</span>
									<div class="chip-group">
										{build.otherRecommendedHeldItemDetails.map(({ slug, item }) =>
											item ? (
												<a href={withBase(`/held-items/${slug}/`)} class="item-chip">
													{item.icon && <img src={item.icon} alt="" class="chip-icon" />}
													{item.name_ja}
												</a>
											) : (
												<span class="item-chip missing">{slug}</span>
											)
										)}
									</div>
								</div>
							)
						}
						{build.note && <p class="note">{build.note}</p>}
					</article>
				))}
			</section>
		)
	}

	{
		moveEntries.length > 0 && (
			<section class="moves-section">
				<h2>わざ説明</h2>
				{moveEntries.map((m) => (
					<article id={`move-${m.key}`} class:list={['move-card', { indent: m.indent }]}>
						<h3>
							{m.data.icon && <img src={m.data.icon} alt="" class="move-icon" />}
							{m.label}: {m.data.name}
						</h3>
						<p>{m.data.effect}</p>
					</article>
				))}
			</section>
		)
	}

	<section class="external-link-card">
		<p>
			詳しい数値データ（ステータス・勝率など）は外部サイトのUniteAPI/unite-db.comをご覧ください。
		</p>
		<a href="https://unite-db.com/" target="_blank" rel="noopener noreferrer">
			unite-db.comで詳細を見る →
		</a>
	</section>

	{
		(usage_memo || counter_memo) && (
			<section class="memo-section">
				{usage_memo && (
					<p class="memo-row">
						<span class="field-label">一言使い方メモ</span>
						<span class="memo-text">{usage_memo}</span>
					</p>
				)}
				{counter_memo && (
					<p class="memo-row">
						<span class="field-label">一言対策メモ</span>
						<span class="memo-text">{counter_memo}</span>
					</p>
				)}
			</section>
		)
	}

	{
		commentarySections.length > 0 && (
			<section class="commentary">
				<h2>立ち回り解説</h2>
				{commentarySections.map((s) => (
					<details class="commentary-accordion">
						<summary>{s.label}</summary>
						<div class="commentary-body" set:html={marked.parse(s.markdown) as string} />
					</details>
				))}
			</section>
		)
	}

	{
		commentary_videos && commentary_videos.length > 0 && (
			<section class="commentary-videos">
				<h2>立ち回り解説動画</h2>
				<div class="video-grid">
					{commentary_videos.map((url) => {
						const videoId = extractYoutubeId(url);
						return videoId ? (
							<div class="video-embed">
								<iframe
									src={`https://www.youtube.com/embed/${videoId}`}
									title="立ち回り解説動画"
									allowfullscreen
									loading="lazy"
								/>
							</div>
						) : (
							<a href={url} target="_blank" rel="noopener noreferrer" class="video-link-fallback">
								{url}
							</a>
						);
					})}
				</div>
			</section>
		)
	}

	{
		relatedFaqs.length > 0 && (
			<FaqSection faqs={relatedFaqs.map((f) => f.data)} moreHref="/faq/?target=pokemon" />
		)
	}
</Layout>

<style>
	.hero-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 24px;
	}

	.hero-left {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		flex: 0 1 auto;
	}

	.hero-left h1 {
		margin: 0;
		text-align: center;
	}

	.badge-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
	}

	.hero-right {
		flex: 1 1 280px;
		display: flex;
		justify-content: flex-end;
		min-width: 280px;
	}

	.pokemon-icon {
		width: 240px;
		height: 240px;
		object-fit: contain;
	}

	.move-icon {
		width: 28px;
		height: 28px;
		object-fit: contain;
		vertical-align: middle;
		margin-right: 6px;
	}

	.items-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
	}

	.items-row + .items-row {
		margin-top: 10px;
	}

	/* おすすめビルド内の項目名（もちもの/バトルアイテム等）は、item-chipと同じ
	   縁取りチップ見た目だと中身のアイテムと見分けづらいため、装飾のないプレーンな
	   キャプション表示に上書きする（グローバルのfield-labelはこのファイル内でしか
	   使っていないため、他ページ（medals/schedule）には影響しない）。 */
	.field-label {
		background: none;
		border: none;
		padding: 0;
		border-radius: 0;
		color: var(--ink-soft);
		font-size: 0.78rem;
	}

	.chip-group {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.item-chip {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 2px 10px;
		border-radius: 999px;
		background: var(--bg);
		border: 1.5px solid color-mix(in srgb, var(--blue) 30%, white);
		color: var(--blue);
		font-weight: 700;
		text-decoration: none;
		font-size: 0.9rem;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.item-chip:hover {
		transform: translateY(-1px);
		box-shadow: 0 4px 10px rgba(76, 111, 255, 0.2);
	}

	.item-chip.missing {
		color: var(--ink-soft);
	}

	.chip-icon {
		width: 18px;
		height: 18px;
		object-fit: contain;
	}

	.role-badge,
	.attack-type-badge,
	.difficulty-badge {
		padding: 4px 12px;
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 700;
		color: #fff;
		box-shadow: 0 2px 6px rgba(27, 34, 51, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.25);
	}

	.attack-type-badge,
	.difficulty-badge {
		background: var(--ink-soft);
	}

	.moves-section {
		margin-top: 24px;
	}

	.move-card {
		margin-top: 12px;
		padding: 16px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.06);
		scroll-margin-top: 16px;
	}

	.move-card.indent {
		margin-left: 24px;
		background: var(--bg);
		border: 1px solid #e5e9f2;
	}

	.move-card h3 {
		margin: 0 0 6px;
		font-size: 1rem;
	}

	.move-card p {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.memo-section {
		margin-top: 20px;
		padding: 16px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.06);
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.memo-row {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		line-height: 1.6;
	}

	.memo-text {
		white-space: pre-wrap;
	}

	.external-link-card {
		margin-top: 20px;
		padding: 16px;
		background: color-mix(in srgb, var(--amber) 8%, white);
		border-radius: var(--radius);
		border: 1.5px solid color-mix(in srgb, var(--amber) 40%, white);
	}

	.build-card {
		margin-top: 12px;
		padding: 16px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.06);
	}

	.note {
		color: var(--ink-soft);
		font-size: 0.9rem;
	}

	.commentary {
		margin-top: 24px;
	}

	.commentary-accordion {
		margin-top: 12px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.06);
		padding: 16px 24px;
	}

	.commentary-accordion summary {
		cursor: pointer;
		font-weight: 700;
		color: var(--blue);
	}

	.commentary-body {
		margin-top: 12px;
		line-height: 1.8;
	}

	.commentary-videos {
		margin-top: 24px;
	}

	.video-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 16px;
		margin-top: 12px;
	}

	.video-embed {
		position: relative;
		width: 100%;
		padding-top: 56.25%;
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.06);
	}

	.video-embed iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.video-link-fallback {
		display: block;
		padding: 12px 16px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		color: var(--blue);
		font-weight: 700;
		text-decoration: none;
		overflow-wrap: anywhere;
	}
</style>
