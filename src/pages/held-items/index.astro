---
// もちもの図鑑 一覧ページ（/held-items/）。
// 参照: CLAUDE-3.md「もちもの／バトルアイテム／メダル 図鑑」
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url';

const heldItems = (await getCollection('held-items')).sort((a, b) =>
	a.data.name_ja.localeCompare(b.data.name_ja, 'ja')
);
---

<Layout title="もちもの">
	<h1>もちもの</h1>
	<ul class="item-list">
		{
			heldItems.map((item) => (
				<li>
					<a href={withBase(`/held-items/${item.data.slug}/`)}>
						{item.data.icon && <img src={item.data.icon} alt="" class="icon" />}
						<span class="text">
							<span class="name">{item.data.name_ja}</span>
							<span class="summary">{item.data.summary}</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>
	{heldItems.length === 0 && <p>準備中です。もうしばらくお待ちください。</p>}
</Layout>

<style>
	.item-list {
		list-style: none;
		margin: 24px 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.item-list a {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 16px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		text-decoration: none;
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.07);
		transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
	}

	.item-list a:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 20px rgba(76, 111, 255, 0.15);
		border-color: var(--blue);
	}

	.icon {
		width: 40px;
		height: 40px;
		object-fit: contain;
		flex-shrink: 0;
	}

	.text {
		display: flex;
		flex-direction: column;
	}

	.name {
		display: block;
		font-family: var(--font-heading);
		font-weight: 700;
	}

	.summary {
		display: block;
		margin-top: 4px;
		color: var(--ink-soft);
		font-size: 0.9rem;
	}
</style>
