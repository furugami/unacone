---
// もちもの個別ページ（/held-items/{slug}/）。
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
	const heldItems = await getCollection('held-items');
	return heldItems.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name_ja, summary, icon } = entry.data;
---

<Layout title={name_ja}>
	<header class="item-header">
		{icon && <img src={icon} alt="" class="icon" />}
		<div>
			<h1>{name_ja}</h1>
			<p class="summary">{summary}</p>
		</div>
	</header>
	<div class="body">
		<Content />
	</div>
</Layout>

<style>
	.item-header {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.icon {
		width: 56px;
		height: 56px;
		object-fit: contain;
		flex-shrink: 0;
	}

	.summary {
		color: var(--ink-soft);
	}

	.body {
		margin-top: 16px;
		background: var(--surface);
		border-radius: var(--radius);
		padding: 24px;
		line-height: 1.8;
	}
</style>
