---
// メダル個別ページ（/medals/{slug}/）。pokemon_slug が設定されていれば対象ポケモンページへリンクする。
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
	const medals = await getCollection('medals');
	return medals.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name_ja, summary, pokemon_slug, icon } = entry.data;

let relatedPokemonName: string | undefined;
if (pokemon_slug) {
	const pokemonList = await getCollection('pokemon-jp');
	relatedPokemonName = pokemonList.find((p) => p.data.slug === pokemon_slug)?.data.name_ja;
}
---

<Layout title={name_ja}>
	<header class="item-header">
		{icon && <img src={icon} alt="" class="icon" />}
		<div>
			<h1>{name_ja}</h1>
			<p class="summary">{summary}</p>
			{
				pokemon_slug && relatedPokemonName && (
					<p class="related-pokemon">
						<span class="field-label">対象ポケモン</span>
						<a href={withBase(`/pokemon/${pokemon_slug}/`)}>{relatedPokemonName}</a>
					</p>
				)
			}
		</div>
	</header>
	<div class="body">
		<Content />
	</div>
</Layout>

<style>
	.item-header {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.icon {
		width: 56px;
		height: 56px;
		object-fit: contain;
		flex-shrink: 0;
	}

	.summary {
		color: var(--ink-soft);
	}

	.related-pokemon {
		margin-top: 8px;
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.related-pokemon a {
		color: var(--blue);
		font-weight: 700;
		text-decoration: none;
	}

	.related-pokemon a:hover {
		text-decoration: underline;
	}

	.body {
		margin-top: 16px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.06);
		padding: 24px;
		line-height: 1.8;
	}
</style>
