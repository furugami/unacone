---
// メダル図鑑 一覧ページ（/medals/）。
// 参照: CLAUDE-3.md「もちもの／バトルアイテム／メダル 図鑑」
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { MEDAL_COLOR_LABELS, MEDAL_COLOR_ORDER, MEDAL_COLOR_SWATCH } from '../../lib/medals';
import MedalCard from '../../components/MedalCard.astro';

// 表示順は order（小さい順）を優先する。CMSでorder未設定のもの（今後追加分など）は
// 末尾にまとめ、その中では五十音順にフォールバックする（2026/08/31追加）。
const medals = (await getCollection('medals')).sort((a, b) => {
	const orderA = a.data.order ?? Infinity;
	const orderB = b.data.order ?? Infinity;
	if (orderA !== orderB) return orderA - orderB;
	return a.data.name_ja.localeCompare(b.data.name_ja, 'ja');
});
const medalBySlug = new Map(medals.map((m) => [m.data.slug, m]));

// おすすめメダルセット（2026/08/31、複数セットを作れる仕様に変更）。
// 1セット＝メダル図鑑から最大10個組み合わせたもの。セット数の制限はない。
const medalSets = (await getCollection('medal-sets')).map((set) => ({
	title: set.data.title,
	medals: set.data.medals
		.map((slug) => medalBySlug.get(slug))
		.filter((m): m is NonNullable<typeof m> => Boolean(m)),
}));

// 属性色フィルタ（2026/08/31追加）。実際に使われている色だけボタンを出す。
const usedColors = new Set(medals.flatMap((m) => m.data.colors ?? []));
const colorFilters = MEDAL_COLOR_ORDER.filter((c) => usedColors.has(c));
---

<Layout title="メダル">
	<h1>メダル</h1>

	{
		medalSets.length > 0 && (
			<section class="recommended-section">
				<h2>おすすめメダルセット</h2>
				{medalSets.map((set) => (
					<div class="medal-set">
						<h3>{set.title}</h3>
						<ul class="item-grid">
							{set.medals.map((item) => (
								<MedalCard
									slug={item.data.slug}
									nameJa={item.data.name_ja}
									icon={item.data.icon}
									colors={item.data.colors}
								/>
							))}
						</ul>
					</div>
				))}
			</section>
		)
	}

	{
		colorFilters.length > 0 && (
			<div class="color-filter" role="group" aria-label="属性色で絞り込み">
				<button type="button" class="filter-btn is-active" data-filter="all">
					すべて
				</button>
				{colorFilters.map((color) => (
					<button
						type="button"
						class="filter-btn"
						data-filter={color}
						style={`--filter-color: ${MEDAL_COLOR_SWATCH[color]}`}
					>
						<span class="filter-dot" style={`background:${MEDAL_COLOR_SWATCH[color]}`} />
						{MEDAL_COLOR_LABELS[color]}
					</button>
				))}
			</div>
		)
	}

	<ul class="item-grid" id="medal-list">
		{
			medals.map((item) => (
				<MedalCard
					slug={item.data.slug}
					nameJa={item.data.name_ja}
					icon={item.data.icon}
					colors={item.data.colors}
				/>
			))
		}
	</ul>
	<p class="no-results" hidden>
		該当するメダルがありません。
	</p>
	{medals.length === 0 && <p>準備中です。もうしばらくお待ちください。</p>}
</Layout>

<script>
	// 属性色フィルタ（複数選択可、OR条件）。ポケモン一覧の絞り込みと違い、
	// メダルは1件で複数の色を持てるため「すべて」以外は複数同時選択できるトグル式にしている。
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const allButton = document.querySelector<HTMLButtonElement>('.filter-btn[data-filter="all"]');
	const items = document.querySelectorAll<HTMLLIElement>('#medal-list > li');
	const noResults = document.querySelector<HTMLParagraphElement>('.no-results');
	const selectedColors = new Set<string>();

	function applyFilter() {
		let visibleCount = 0;
		items.forEach((item) => {
			const colors = (item.dataset.colors ?? '').split(' ').filter(Boolean);
			const matches = selectedColors.size === 0 || colors.some((c) => selectedColors.has(c));
			item.hidden = !matches;
			if (matches) visibleCount++;
		});
		if (noResults) noResults.hidden = visibleCount > 0;
	}

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const filter = button.dataset.filter;
			if (filter === 'all') {
				selectedColors.clear();
				buttons.forEach((b) => b.classList.remove('is-active'));
				allButton?.classList.add('is-active');
			} else if (filter) {
				if (selectedColors.has(filter)) {
					selectedColors.delete(filter);
					button.classList.remove('is-active');
				} else {
					selectedColors.add(filter);
					button.classList.add('is-active');
				}
				allButton?.classList.toggle('is-active', selectedColors.size === 0);
			}
			applyFilter();
		});
	});
</script>

<style>
	.recommended-section {
		margin-bottom: 32px;
	}

	.medal-set + .medal-set {
		margin-top: 24px;
	}

	.medal-set h3 {
		margin: 16px 0 0;
		font-size: 1rem;
	}

	.color-filter {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 16px;
	}

	.filter-btn {
		--filter-color: var(--ink-soft);
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 0.85rem;
		padding: 6px 14px;
		border-radius: 999px;
		border: 1.5px solid var(--filter-color);
		background: var(--surface);
		color: var(--ink);
		cursor: pointer;
		transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
	}

	.filter-btn:hover {
		transform: translateY(-2px);
	}

	.filter-btn.is-active {
		background: color-mix(in srgb, var(--filter-color) 18%, white);
		border-color: var(--filter-color);
	}

	.filter-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		flex-shrink: 0;
		border: 1px solid rgba(27, 34, 51, 0.15);
	}

	.no-results {
		margin-top: 24px;
		color: var(--ink-soft);
	}

	.item-grid {
		list-style: none;
		margin: 24px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
		gap: 4px;
	}
</style>
