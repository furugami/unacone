---
// バトルアイテム個別ページ（/battle-items/{slug}/）。
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
	const battleItems = await getCollection('battle-items');
	return battleItems.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name_ja, icon, cooldown_seconds, unlock_level } = entry.data;

// CMSで一度入力してから空欄に戻すと undefined ではなく空文字列になるため、
// 空文字列も「未設定」として扱う。
const hasUnlockLevel = unlock_level !== undefined && unlock_level.trim() !== '';
// 数値のみ（例: "10"）ならトレーナーレベルの文言で、それ以外（例: "ショップで購入可能"）は
// そのまま表示する。レベル制限がなくショップ等で入手できるアイテムがあるため。
const unlockLevelIsNumeric = hasUnlockLevel && /^\d+$/.test(unlock_level.trim());
---

<Layout title={name_ja}>
	<header class="item-header">
		{icon && <img src={icon} alt="" class="icon" />}
		<div>
			<h1>{name_ja}</h1>
			<p class="meta">
				{cooldown_seconds !== undefined && <span class="badge">クールダウン {cooldown_seconds}秒</span>}
			</p>
		</div>
	</header>
	<div class="body">
		<Content />
	</div>
	{
		hasUnlockLevel && (
			<div class="unlock-section">
				<h2>解放条件</h2>
				<p>{unlockLevelIsNumeric ? `トレーナーレベル ${unlock_level} で解放されます。` : unlock_level}</p>
			</div>
		)
	}
</Layout>

<style>
	.item-header {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.icon {
		width: 56px;
		height: 56px;
		object-fit: contain;
		flex-shrink: 0;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 8px;
	}

	.badge {
		font-size: 0.8rem;
		font-weight: 700;
		font-family: var(--font-number);
		color: var(--blue);
		background: color-mix(in srgb, var(--blue) 10%, white);
		border: 1.5px solid color-mix(in srgb, var(--blue) 30%, white);
		border-radius: 999px;
		padding: 2px 10px;
	}

	.body {
		margin-top: 16px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.06);
		padding: 24px;
		line-height: 1.8;
	}

	.unlock-section {
		margin-top: 16px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.06);
		padding: 24px;
		line-height: 1.8;
	}

	.unlock-section h2 {
		margin: 0 0 8px;
	}

	.unlock-section p {
		margin: 0;
		color: var(--ink-soft);
	}
</style>
