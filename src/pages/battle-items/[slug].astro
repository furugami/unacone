---
// バトルアイテム個別ページ（/battle-items/{slug}/）。
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
	const battleItems = await getCollection('battle-items');
	return battleItems.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name_ja, summary, icon, cooldown_seconds, unlock_level } = entry.data;
---

<Layout title={name_ja}>
	<header class="item-header">
		{icon && <img src={icon} alt="" class="icon" />}
		<div>
			<h1>{name_ja}</h1>
			<p class="summary">{summary}</p>
			<p class="meta">
				{cooldown_seconds !== undefined && <span class="badge">クールダウン {cooldown_seconds}秒</span>}
				{unlock_level !== undefined && <span class="badge">トレーナーレベル {unlock_level}で解除</span>}
			</p>
		</div>
	</header>
	<div class="body">
		<Content />
	</div>
</Layout>

<style>
	.item-header {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.icon {
		width: 56px;
		height: 56px;
		object-fit: contain;
		flex-shrink: 0;
	}

	.summary {
		color: var(--ink-soft);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 8px;
	}

	.badge {
		font-size: 0.8rem;
		font-family: var(--font-number);
		color: var(--ink-soft);
		background: var(--bg);
		border-radius: 999px;
		padding: 2px 10px;
	}

	.body {
		margin-top: 16px;
		background: var(--surface);
		border-radius: var(--radius);
		padding: 24px;
		line-height: 1.8;
	}
</style>
