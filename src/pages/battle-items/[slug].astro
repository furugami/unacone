---
// バトルアイテム個別ページ（/battle-items/{slug}/）。
import Layout from '../../layouts/Layout.astro';
import FaqSection from '../../components/FaqSection.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
	const battleItems = await getCollection('battle-items');
	return battleItems.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name_ja, icon, cooldown_seconds, unlock_level, recommended_pokemon } = entry.data;

// このバトルアイテムを対象にしているFAQだけを抽出（faqs側が対象を持つ設計。
// src/content.config.tsの「faqs」コレクション参照）。
const relatedFaqs = (await getCollection('faqs')).filter(
	(f) => f.data.target_battle_item === entry.data.slug
);

// CMSで一度入力してから空欄に戻すと undefined ではなく空文字列になるため、
// 空文字列も「未設定」として扱う。
const hasUnlockLevel = unlock_level !== undefined && unlock_level.trim() !== '';
// 数値のみ（例: "10"）ならトレーナーレベルの文言で、それ以外（例: "ショップで購入可能"）は
// そのまま表示する。レベル制限がなくショップ等で入手できるアイテムがあるため。
const unlockLevelIsNumeric = hasUnlockLevel && /^\d+$/.test(unlock_level.trim());

// おすすめポケモンはポケモン図鑑のslugを指しているので、実データ（名前・アイコン）に解決する。
const pokemonMap = new Map((await getCollection('pokemon-jp')).map((p) => [p.data.slug, p.data]));
const recommendedPokemonDetails = (recommended_pokemon ?? []).map((slug) => ({
	slug,
	pokemon: pokemonMap.get(slug),
}));
---

<Layout title={name_ja}>
	<header class="item-header">
		{icon && <img src={icon} alt="" class="icon" />}
		<div>
			<h1>{name_ja}</h1>
			<p class="meta">
				{cooldown_seconds !== undefined && <span class="badge">クールダウン {cooldown_seconds}秒</span>}
			</p>
		</div>
	</header>
	<div class="body">
		<Content />
	</div>
	{
		recommendedPokemonDetails.length > 0 && (
			<div class="recommended-section">
				<h2>おすすめポケモン</h2>
				<div class="pokemon-chips">
					{recommendedPokemonDetails.map(({ slug, pokemon }) =>
						pokemon ? (
							<a href={withBase(`/pokemon/${slug}/`)} class="item-chip">
								{pokemon.icon && <img src={pokemon.icon} alt="" class="chip-icon" />}
								{pokemon.name_ja}
							</a>
						) : (
							<span class="item-chip missing">{slug}</span>
						)
					)}
				</div>
			</div>
		)
	}
	{
		hasUnlockLevel && (
			<div class="unlock-section">
				<h2>解放条件</h2>
				<p>{unlockLevelIsNumeric ? `トレーナーレベル ${unlock_level} で解放されます。` : unlock_level}</p>
			</div>
		)
	}
	{
		relatedFaqs.length > 0 && (
			<FaqSection
				faqs={relatedFaqs.map((f) => f.data)}
				moreHref="/faq/?target=battle-item"
			/>
		)
	}
</Layout>

<style>
	.item-header {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.icon {
		width: 56px;
		height: 56px;
		object-fit: contain;
		flex-shrink: 0;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 8px;
	}

	.badge {
		font-size: 0.8rem;
		font-weight: 700;
		font-family: var(--font-number);
		color: var(--blue);
		background: color-mix(in srgb, var(--blue) 10%, white);
		border: 1.5px solid color-mix(in srgb, var(--blue) 30%, white);
		border-radius: 999px;
		padding: 2px 10px;
	}

	.body {
		margin-top: 16px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.06);
		padding: 24px;
		line-height: 1.8;
	}

	.unlock-section {
		margin-top: 16px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.06);
		padding: 24px;
		line-height: 1.8;
	}

	.unlock-section h2 {
		margin: 0 0 8px;
	}

	.unlock-section p {
		margin: 0;
		color: var(--ink-soft);
	}

	.recommended-section {
		margin-top: 16px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.06);
		padding: 24px;
	}

	.recommended-section h2 {
		margin: 0 0 16px;
	}

	.pokemon-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.item-chip {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 2px 10px;
		border-radius: 999px;
		background: var(--bg);
		border: 1.5px solid color-mix(in srgb, var(--blue) 30%, white);
		color: var(--blue);
		font-weight: 700;
		text-decoration: none;
		font-size: 0.9rem;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.item-chip:hover {
		transform: translateY(-1px);
		box-shadow: 0 4px 10px rgba(76, 111, 255, 0.2);
	}

	.item-chip.missing {
		color: var(--ink-soft);
	}

	.chip-icon {
		width: 18px;
		height: 18px;
		object-fit: contain;
	}
</style>
