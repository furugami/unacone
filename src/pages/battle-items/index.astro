---
// バトルアイテム図鑑 一覧ページ（/battle-items/）。
// 参照: CLAUDE-3.md「もちもの／バトルアイテム／メダル 図鑑」
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url';

const battleItems = (await getCollection('battle-items')).sort((a, b) =>
	a.data.name_ja.localeCompare(b.data.name_ja, 'ja')
);
---

<Layout title="バトルアイテム">
	<h1>バトルアイテム</h1>
	<ul class="item-grid">
		{
			battleItems.map((item) => (
				<li>
					<a href={withBase(`/battle-items/${item.data.slug}/`)}>
						{item.data.icon && <img src={item.data.icon} alt="" class="icon" />}
						<span class="name">{item.data.name_ja}</span>
						<span class="meta">
							{item.data.cooldown_seconds !== undefined && (
								<span class="badge">CT {item.data.cooldown_seconds}秒</span>
							)}
						</span>
					</a>
				</li>
			))
		}
	</ul>
	{battleItems.length === 0 && <p>準備中です。もうしばらくお待ちください。</p>}
</Layout>

<style>
	.item-grid {
		list-style: none;
		margin: 24px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: 12px;
	}

	.item-grid a {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 6px;
		padding: 16px 12px;
		height: 100%;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		text-decoration: none;
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.07);
		transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
	}

	.item-grid a:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 20px rgba(76, 111, 255, 0.15);
		border-color: var(--blue);
	}

	.icon {
		width: 48px;
		height: 48px;
		object-fit: contain;
	}

	.name {
		font-family: var(--font-heading);
		font-weight: 700;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 4px;
	}

	.badge {
		font-size: 0.75rem;
		font-weight: 700;
		font-family: var(--font-number);
		color: var(--blue);
		background: color-mix(in srgb, var(--blue) 10%, white);
		border: 1.5px solid color-mix(in srgb, var(--blue) 30%, white);
		border-radius: 999px;
		padding: 2px 8px;
	}

</style>
