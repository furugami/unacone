---
// バトルアイテム図鑑 一覧ページ（/battle-items/）。
// 参照: CLAUDE-3.md「もちもの／バトルアイテム／メダル 図鑑」
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url';

const battleItems = (await getCollection('battle-items')).sort((a, b) =>
	a.data.name_ja.localeCompare(b.data.name_ja, 'ja')
);
---

<Layout title="バトルアイテム">
	<h1>バトルアイテム</h1>
	<ul class="item-grid">
		{
			battleItems.map((item) => (
				<li>
					<a href={withBase(`/battle-items/${item.data.slug}/`)}>
						{item.data.icon && <img src={item.data.icon} alt="" class="icon" />}
						<span class="name">{item.data.name_ja}</span>
						<span class="meta">
							{item.data.cooldown_seconds !== undefined && (
								<span class="badge">CT {item.data.cooldown_seconds}秒</span>
							)}
							{item.data.unlock_level !== undefined && (
								<span class="badge">Lv.{item.data.unlock_level}〜</span>
							)}
						</span>
						<span class="summary">{item.data.summary}</span>
					</a>
				</li>
			))
		}
	</ul>
	{battleItems.length === 0 && <p>準備中です。もうしばらくお待ちください。</p>}
</Layout>

<style>
	.item-grid {
		list-style: none;
		margin: 24px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: 12px;
	}

	.item-grid a {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 6px;
		padding: 16px 12px;
		height: 100%;
		background: var(--surface);
		border-radius: var(--radius);
		text-decoration: none;
		box-shadow: 0 1px 2px rgba(27, 34, 51, 0.08);
	}

	.icon {
		width: 48px;
		height: 48px;
		object-fit: contain;
	}

	.name {
		font-family: var(--font-heading);
		font-weight: 700;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 4px;
	}

	.badge {
		font-size: 0.75rem;
		font-family: var(--font-number);
		color: var(--ink-soft);
		background: var(--bg);
		border-radius: 999px;
		padding: 2px 8px;
	}

	.summary {
		color: var(--ink-soft);
		font-size: 0.85rem;
	}
</style>
