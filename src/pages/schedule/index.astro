---
// 配信スケジュールページ（/schedule/）。データは配信者ごとにTwitch/YouTube公式APIから
// ビルド時に取得する（CMS管理はしない）。実装は最小限のシンプルなリスト表示に留める方針
// （CLAUDE-3.md「配信者カレンダー実装方針の軽量化」参照）。
// 「配信中(LIVE)」表示は、cronを30分間隔に変更しラグが許容範囲になったため2026/08/31に対応。
import Layout from '../../layouts/Layout.astro';
import ScheduleTable from '../../components/ScheduleTable.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url';
import {
	fetchTwitchSchedule,
	fetchTwitchLive,
	fetchYoutubeUpcoming,
	fetchYoutubeLive,
	fetchYoutubeUpcomingByKeyword,
	fetchYoutubeLiveByKeyword,
	filterAndSortDiscoveredLive,
	type ScheduleEntry,
} from '../../lib/schedule';

// トップページに表示する広域検索LIVEの最大件数。超える分は「すべてのライブ中配信を表示」
// リンク先（/schedule/live/）でまとめて見られるようにする（2026/08/31追加、運営者要望）。
const DISCOVERED_LIVE_LIMIT = 10;

const streamers = await getCollection('streamers');

// YouTube広域検索で見つかっても一覧に出したくないチャンネルの除外リスト（CMSで管理）。
const scheduleSettings = (await getCollection('schedule-settings'))[0];
const excludedChannelNames = new Set(
	(scheduleSettings?.data.excluded_channel_names ?? []).map((name) => name.trim())
);

// 予約配信の表示範囲は「現在〜3日後」のみ（配信中の見逃し防止に1時間分だけ過去も含める）。
// 配信中(isLive)のエントリはこの範囲チェックの対象外（配信が長時間になっても表示し続けるため）。
const now = new Date();
const rangeStart = new Date(now.getTime() - 60 * 60 * 1000);
const rangeEnd = new Date(now.getTime() + 3 * 24 * 60 * 60 * 1000);
const inRange = (entry: ScheduleEntry) => entry.startTime >= rangeStart && entry.startTime <= rangeEnd;

const scheduleByStreamer = await Promise.all(
	streamers.map(async (streamer) => {
		const liveEntries: ScheduleEntry[] = [
			...(streamer.data.twitch_channel
				? await fetchTwitchLive(streamer.data.twitch_channel).then((e) => (e ? [e] : []))
				: []),
			...(streamer.data.youtube_channel_id
				? await fetchYoutubeLive(streamer.data.youtube_channel_id)
				: []),
		];
		const entries: ScheduleEntry[] = [
			...(streamer.data.twitch_channel ? await fetchTwitchSchedule(streamer.data.twitch_channel) : []),
			...(streamer.data.youtube_channel_id
				? await fetchYoutubeUpcoming(streamer.data.youtube_channel_id)
				: []),
		]
			.filter(inRange)
			.sort((a, b) => a.startTime.valueOf() - b.startTime.valueOf());
		return { streamer, liveEntries, entries };
	})
);

// 登録配信者に限らず、YouTubeを「ポケモンユナイト」で検索して見つかった配信。
// 精度は完全ではない（無関係な動画が混ざりうる）前提の補助的な一覧。
const registeredYoutubeChannelIds = new Set(
	streamers.map((s) => s.data.youtube_channel_id).filter((id): id is string => Boolean(id))
);
const notDuplicateOrExcluded = (entry: ScheduleEntry) =>
	(!entry.channelId || !registeredYoutubeChannelIds.has(entry.channelId)) &&
	(!entry.channelName || !excludedChannelNames.has(entry.channelName.trim()));

// LIVEはチャンネル登録者数が多い順に並べ、件数が多いときはトップページには上位のみ表示する。
const discoveredLiveEntriesAll = filterAndSortDiscoveredLive(
	await fetchYoutubeLiveByKeyword('ポケモンユナイト'),
	registeredYoutubeChannelIds,
	excludedChannelNames
);
const discoveredLiveEntries = discoveredLiveEntriesAll.slice(0, DISCOVERED_LIVE_LIMIT);
const hasMoreDiscoveredLive = discoveredLiveEntriesAll.length > DISCOVERED_LIVE_LIMIT;

const discoveredEntries = (await fetchYoutubeUpcomingByKeyword('ポケモンユナイト'))
	.filter(inRange)
	.filter(notDuplicateOrExcluded)
	.sort((a, b) => a.startTime.valueOf() - b.startTime.valueOf());
---

<Layout title="配信スケジュール">
	<h1>配信スケジュール</h1>

	{
		scheduleByStreamer.length > 0 && (
			<ul class="streamer-list">
				{scheduleByStreamer.map(({ streamer, liveEntries, entries }) => (
					<li class="streamer-block">
						<h2>{streamer.data.name}</h2>
						{liveEntries.length === 0 && entries.length === 0 && (
							<p class="no-schedule">現在配信予定が確認できません。予定は配信者のSNS等でご確認ください。</p>
						)}
						{(liveEntries.length > 0 || entries.length > 0) && (
							<ScheduleTable liveEntries={liveEntries} entries={entries} />
						)}
					</li>
				))}
			</ul>
		)
	}

	{
		(discoveredLiveEntriesAll.length > 0 || discoveredEntries.length > 0) && (
			<section class="discovered-section">
				<h2>その他のユナイト配信（YouTube検索）</h2>
				<p class="discovered-note">
					「ポケモンユナイト」でYouTubeを検索して見つかった配信です。無関係な動画が混ざる場合があります。
				</p>
				<ScheduleTable liveEntries={discoveredLiveEntries} entries={discoveredEntries} showChannelName />
				{hasMoreDiscoveredLive && (
					<p class="live-more-link">
						<a href={withBase('/schedule/live/')}>すべてのライブ中配信を表示 →</a>
					</p>
				)}
			</section>
		)
	}

	{
		scheduleByStreamer.length === 0 &&
			discoveredLiveEntriesAll.length === 0 &&
			discoveredEntries.length === 0 && <p>現在、3日以内の配信予定は見つかりませんでした。</p>
	}
</Layout>

<style>
	.streamer-list {
		list-style: none;
		margin: 24px 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.streamer-block {
		padding: 20px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.07);
	}

	.streamer-block h2 {
		margin: 0 0 12px;
		font-size: 1.1rem;
	}

	.no-schedule {
		color: var(--ink-soft);
		font-size: 0.9rem;
		margin: 0;
	}

	.discovered-section {
		margin-top: 32px;
		padding: 20px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.07);
	}

	.discovered-note {
		margin: 4px 0 16px;
		color: var(--ink-soft);
		font-size: 0.8rem;
	}

	.live-more-link {
		margin: 12px 0 0;
		text-align: right;
	}

	.live-more-link a {
		color: var(--blue);
		font-weight: 700;
		font-size: 0.9rem;
		text-decoration: none;
	}

	.live-more-link a:hover {
		text-decoration: underline;
	}
</style>
