---
// 配信スケジュールページ（/schedule/）。データは配信者ごとにTwitch/YouTube公式APIから
// ビルド時に取得する（CMS管理はしない）。実装は最小限のシンプルなリスト表示に留める方針
// （CLAUDE-3.md「配信者カレンダー実装方針の軽量化」参照）。「配信中(LIVE)」表示はPhase 2。
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import {
	fetchTwitchSchedule,
	fetchYoutubeUpcoming,
	fetchYoutubeUpcomingByKeyword,
	type ScheduleEntry,
} from '../../lib/schedule';

const streamers = await getCollection('streamers');

// 表示するのは「現在〜3日後」の予定のみ（配信中の見逃し防止に1時間分だけ過去も含める）。
// 更新頻度（cronでの再ビルド間隔）は別途検討のため、ここでは範囲の絞り込みだけを行う。
const now = new Date();
const rangeStart = new Date(now.getTime() - 60 * 60 * 1000);
const rangeEnd = new Date(now.getTime() + 3 * 24 * 60 * 60 * 1000);
const inRange = (entry: ScheduleEntry) => entry.startTime >= rangeStart && entry.startTime <= rangeEnd;

const scheduleByStreamer = await Promise.all(
	streamers.map(async (streamer) => {
		const entries: ScheduleEntry[] = [
			...(streamer.data.twitch_channel ? await fetchTwitchSchedule(streamer.data.twitch_channel) : []),
			...(streamer.data.youtube_channel_id
				? await fetchYoutubeUpcoming(streamer.data.youtube_channel_id)
				: []),
		]
			.filter(inRange)
			.sort((a, b) => a.startTime.valueOf() - b.startTime.valueOf());
		return { streamer, entries };
	})
);

// 登録配信者に限らず、YouTubeを「ポケモンユナイト」で検索して見つかった予約配信。
// 精度は完全ではない（無関係な動画が混ざりうる）前提の補助的な一覧。
const registeredYoutubeChannelIds = new Set(
	streamers.map((s) => s.data.youtube_channel_id).filter((id): id is string => Boolean(id))
);
const discoveredEntries = (await fetchYoutubeUpcomingByKeyword('ポケモンユナイト'))
	.filter(inRange)
	.filter((entry) => !entry.channelId || !registeredYoutubeChannelIds.has(entry.channelId))
	.sort((a, b) => a.startTime.valueOf() - b.startTime.valueOf());
---

<Layout title="配信スケジュール">
	<h1>配信スケジュール</h1>

	{
		scheduleByStreamer.length > 0 ? (
			<ul class="streamer-list">
				{scheduleByStreamer.map(({ streamer, entries }) => (
					<li class="streamer-block">
						<h2>{streamer.data.name}</h2>
						{entries.length > 0 ? (
							<ul class="entry-list">
								{entries.map((entry) => (
									<li>
										<a href={entry.url} target="_blank" rel="noopener noreferrer">
											<span class="datetime">
												{entry.startTime.toLocaleString('ja-JP', {
													month: 'numeric',
													day: 'numeric',
													weekday: 'short',
													hour: '2-digit',
													minute: '2-digit',
												})}
											</span>
											<span class="entry-title">{entry.title}</span>
											<span class={`platform-badge platform-${entry.platform}`}>
												{entry.platform === 'twitch' ? 'Twitch' : 'YouTube'}
											</span>
										</a>
									</li>
								))}
							</ul>
						) : (
							<p class="no-schedule">現在配信予定が確認できません。予定は配信者のSNS等でご確認ください。</p>
						)}
					</li>
				))}
			</ul>
		) : (
			<p>準備中です。もうしばらくお待ちください。</p>
		)
	}

	{
		discoveredEntries.length > 0 && (
			<section class="discovered-section">
				<h2>その他のユナイト配信予定（YouTube検索）</h2>
				<p class="discovered-note">
					「ポケモンユナイト」でYouTubeを検索して見つかった予約配信です。無関係な動画が混ざる場合があります。
				</p>
				<ul class="entry-list">
					{discoveredEntries.map((entry) => (
						<li>
							<a href={entry.url} target="_blank" rel="noopener noreferrer">
								<span class="datetime">
									{entry.startTime.toLocaleString('ja-JP', {
										month: 'numeric',
										day: 'numeric',
										weekday: 'short',
										hour: '2-digit',
										minute: '2-digit',
									})}
								</span>
								<span class="entry-title">
									{entry.channelName} - {entry.title}
								</span>
								<span class="platform-badge platform-youtube">YouTube</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Layout>

<style>
	.streamer-list {
		list-style: none;
		margin: 24px 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.streamer-block {
		padding: 20px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.07);
	}

	.streamer-block h2 {
		margin: 0 0 12px;
		font-size: 1.1rem;
	}

	.entry-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.entry-list a {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		padding: 8px 0;
	}

	.platform-badge {
		flex-shrink: 0;
		padding: 3px 12px;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 700;
		color: #fff;
		box-shadow: 0 2px 6px rgba(27, 34, 51, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.25);
	}

	.platform-twitch {
		background: #9146ff;
	}

	.platform-youtube {
		background: #ff0000;
	}

	.datetime {
		flex-shrink: 0;
		font-family: var(--font-number);
		color: var(--ink-soft);
		font-size: 0.9rem;
	}

	.no-schedule {
		color: var(--ink-soft);
		font-size: 0.9rem;
		margin: 0;
	}

	.discovered-section {
		margin-top: 32px;
		padding: 20px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.07);
	}

	.discovered-note {
		margin: 4px 0 16px;
		color: var(--ink-soft);
		font-size: 0.8rem;
	}
</style>
