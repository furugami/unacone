---
// セオリー解説記事の目次ページ（/articles/）。
// 難易度カテゴリ（初心者/中級/上級）ごとにセクション分けし、グリッドで表示する。
// 各カテゴリは新しい順に2段（6件）までのプレビューに留め、それを超える分は
// 「すべての◯◯向け記事を表示」リンクから /articles/all/（全件フィルタページ）に遷移する
// （2026/08/31、運営者要望でグリッド化・タグ機能とあわせて改修）。
// 参照: CLAUDE.md「セオリー解説記事 コンテンツモデル」
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ARTICLE_CATEGORY_LABELS, ARTICLE_CATEGORY_ORDER } from '../../lib/articles';
import { withBase } from '../../lib/url';
import ArticleCard from '../../components/ArticleCard.astro';

const PREVIEW_LIMIT = 6; // 3列×2段ぶん

const allArticles = await getCollection('articles');

// カテゴリごとにグループ化し、各グループ内は公開日の新しい順に並べる。
// 記事が1件も無いカテゴリはセクションごと表示しない。
const sections = ARTICLE_CATEGORY_ORDER.map((category) => {
	const articlesInCategory = allArticles
		.filter((a) => a.data.category === category)
		.sort((a, b) => b.data.publish_date.valueOf() - a.data.publish_date.valueOf());
	return {
		category,
		preview: articlesInCategory.slice(0, PREVIEW_LIMIT),
		hasMore: articlesInCategory.length > PREVIEW_LIMIT,
	};
}).filter((section) => section.preview.length > 0);
---

<Layout title="セオリー解説記事">
	<h1>セオリー解説記事</h1>

	{
		sections.map((section) => (
			<section class="category-section">
				<h2>{ARTICLE_CATEGORY_LABELS[section.category]}</h2>
				<ul class="article-grid">
					{section.preview.map((article) => (
						<ArticleCard
							slug={article.data.slug}
							title={article.data.title}
							excerpt={article.data.excerpt}
							category={article.data.category}
							tags={article.data.tags}
							thumbnail={article.data.thumbnail}
						/>
					))}
				</ul>
				{section.hasMore && (
					<p class="more-link">
						<a href={withBase(`/articles/all/?category=${section.category}`)}>
							すべての{ARTICLE_CATEGORY_LABELS[section.category]}記事を表示 →
						</a>
					</p>
				)}
			</section>
		))
	}

	{sections.length === 0 && <p>準備中です。もうしばらくお待ちください。</p>}
</Layout>

<style>
	.category-section {
		margin-top: 32px;
	}

	.article-grid {
		list-style: none;
		margin: 16px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 16px;
	}

	.more-link {
		margin: 12px 0 0;
		text-align: right;
	}

	.more-link a {
		color: var(--blue);
		font-weight: 700;
		font-size: 0.9rem;
		text-decoration: none;
	}

	.more-link a:hover {
		text-decoration: underline;
	}
</style>
