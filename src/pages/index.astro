---
// トップページ（/）。確定済みヒーロー構成（CLAUDE-3.md「トップページヒーロー構成」参照）:
// 1. キャッチコピー 2. ポケモンTier表 3. セオリー記事への導線 4. 図鑑への入り口
// 配信スケジュール・Discordはヘッダーナビからの導線のみで、ここには置かない。
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ROLE_COLOR_VARS, TIER_ORDER } from '../lib/pokemon';
import { withBase } from '../lib/url';

const pokemonList = await getCollection('pokemon-jp');

const tierRows = TIER_ORDER.map((tier) => ({
	tier,
	pokemon: pokemonList.filter((p) => p.data.tier === tier),
})).filter((row) => row.pokemon.length > 0);

const latestArticles = (await getCollection('articles'))
	.sort((a, b) => b.data.publish_date.valueOf() - a.data.publish_date.valueOf())
	.slice(0, 3);
---

<Layout title="トップページ">
	<section class="hero">
		<h1>ユナイト関連で、まず最初に来るサイト。</h1>
		<p>図鑑・セオリー記事・仲間探しをまとめてここに。</p>
	</section>

	<section class="tier-section">
		<div class="section-header">
			<h2>現在のTier表</h2>
			<a href={withBase('/pokemon/')}>一覧をもっと見る →</a>
		</div>
		{
			tierRows.length > 0 ? (
				tierRows.map((row) => (
					<div class="tier-row">
						<span class={`tier-label tier-${row.tier}`}>{row.tier}</span>
						<ul class="tier-pokemon-list">
							{row.pokemon.map((p) => (
								<li>
									<a
										href={withBase(`/pokemon/${p.data.slug}/`)}
										style={`--role-color: var(${ROLE_COLOR_VARS[p.data.role]})`}
									>
										{p.data.name_ja}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			) : (
				<p>Tier表は準備中です。</p>
			)
		}
	</section>

	<section class="articles-section">
		<div class="section-header">
			<h2>セオリー解説記事</h2>
			<a href={withBase('/articles/')}>記事一覧を見る →</a>
		</div>
		{
			latestArticles.length > 0 ? (
				<ul class="article-cards">
					{latestArticles.map((a) => (
						<li>
							<a href={withBase(`/articles/${a.data.slug}/`)}>
								<span class="title">{a.data.title}</span>
								<span class="excerpt">{a.data.excerpt}</span>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p>記事は準備中です。</p>
			)
		}
	</section>

	<section class="pokemon-cta">
		<a class="cta-button" href={withBase('/pokemon/')}>ポケモン一覧を見る →</a>
	</section>
</Layout>

<style>
	.hero {
		text-align: center;
		padding: 48px 24px;
		border-radius: var(--radius);
		background: linear-gradient(135deg, var(--blue), #7c93ff 60%, var(--amber));
		box-shadow: 0 8px 24px rgba(76, 111, 255, 0.25);
	}

	.hero h1 {
		font-size: 2rem;
		margin: 0 0 8px;
		color: #fff;
	}

	.hero p {
		color: rgba(255, 255, 255, 0.9);
		margin: 0;
	}

	section {
		margin-top: 40px;
	}

	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
	}

	.section-header a {
		font-size: 0.85rem;
		color: var(--blue);
		text-decoration: none;
	}

	.tier-row {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-top: 12px;
	}

	.tier-label {
		flex-shrink: 0;
		width: 40px;
		height: 40px;
		border-radius: var(--radius);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-number);
		font-weight: 700;
		font-size: 1.1rem;
		color: #fff;
		box-shadow: 0 3px 8px rgba(27, 34, 51, 0.2);
	}

	.tier-S {
		background: var(--amber);
	}
	.tier-A {
		background: var(--blue);
	}
	.tier-B {
		background: var(--tier-b);
	}
	.tier-C {
		background: var(--ink-soft);
	}

	.tier-pokemon-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.tier-pokemon-list a {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 6px 14px;
		border-radius: 999px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 700;
		transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
	}

	.tier-pokemon-list a:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 14px rgba(27, 34, 51, 0.12);
		border-color: var(--role-color);
	}

	.tier-pokemon-list a::before {
		content: '';
		width: 8px;
		height: 8px;
		flex-shrink: 0;
		border-radius: 50%;
		background: var(--role-color);
	}

	.article-cards {
		list-style: none;
		margin: 12px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 12px;
	}

	.article-cards a {
		display: block;
		padding: 16px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		text-decoration: none;
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.07);
		transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
	}

	.article-cards a:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 20px rgba(76, 111, 255, 0.15);
		border-color: var(--blue);
	}

	.article-cards .title {
		display: block;
		font-family: var(--font-heading);
		font-weight: 700;
	}

	.article-cards .excerpt {
		display: block;
		margin-top: 4px;
		color: var(--ink-soft);
		font-size: 0.85rem;
	}

	.pokemon-cta {
		text-align: center;
	}

	.cta-button {
		display: inline-block;
		padding: 14px 32px;
		border-radius: 999px;
		background: linear-gradient(135deg, var(--blue), #6f89ff);
		color: #fff;
		text-decoration: none;
		font-weight: 700;
		box-shadow: 0 6px 16px rgba(76, 111, 255, 0.35);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.cta-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 22px rgba(76, 111, 255, 0.4);
	}
</style>
