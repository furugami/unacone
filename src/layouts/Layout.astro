---
// 全ページ共通のレイアウト。<head>・ヘッダーナビ・フッターをここに集約する。
// 各ページは <Layout title="..."> 中身 </Layout> という形で使う。
import { withBase } from '../lib/url';

interface Props {
  title: string;
}

const { title } = Astro.props;

const navItems = [
  { href: withBase('/pokemon/'), label: 'ポケモン' },
  { href: withBase('/held-items/'), label: 'もちもの' },
  { href: withBase('/battle-items/'), label: 'バトルアイテム' },
  { href: withBase('/medals/'), label: 'メダル' },
  { href: withBase('/articles/'), label: 'セオリー記事' },
  { href: withBase('/schedule/'), label: '配信スケジュール' },
  { href: withBase('/faq/'), label: 'よくある質問' },
  { href: withBase('/discord/'), label: 'Discord' },
];
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | ユナコネ</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700&family=Noto+Sans+JP:wght@400;500;700&family=M+PLUS+Rounded+1c:wght@400;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="site-header">
			<a class="site-logo" href={withBase('/')}>ユナコネ</a>
			<nav class="site-nav">
				{navItems.map((item) => (
					<a href={item.href}>{item.label}</a>
				))}
			</nav>
			<details class="mobile-nav">
				<summary aria-label="メニューを開く"><span class="hamburger-icon"></span></summary>
				<nav class="mobile-nav-menu">
					{navItems.map((item) => (
						<a href={item.href}>{item.label}</a>
					))}
				</nav>
			</details>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p>ユナコネ — ユナイト関連でまず最初に来るサイト</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg: #f5f7fb;
		--surface: #ffffff;
		--ink: #1b2233;
		--ink-soft: #6b7280;
		--blue: #4c6fff;
		--amber: #ffb238;

		/* ロールカラー。公式のロールアイコンの色味にできるだけ寄せている
		   （アタック型=赤／バランス型=紫／ディフェンス型=緑／スピード型=青／サポート型=黄）。 */
		--r-attacker: #e6484f;
		--r-allrounder: #9b59d0;
		--r-defender: #3fa65c;
		--r-speedster: #4a90e2;
		--r-supporter: #f2c230;

		/* Tier表のTier B用（ロールカラーとは無関係の独立色。ロール色更新の影響を受けないよう分離）。 */
		--tier-b: #2bc7a0;

		--radius: 12px;

		--font-heading: 'Zen Kaku Gothic New', sans-serif;
		--font-body: 'Noto Sans JP', sans-serif;
		--font-number: 'M PLUS Rounded 1c', sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--ink);
		font-family: var(--font-body);
	}

	h1,
	h2,
	h3,
	h4 {
		font-family: var(--font-heading);
	}

	h2 {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 1.3rem;
		padding-left: 12px;
		border-left: 5px solid var(--blue);
	}

	a {
		color: inherit;
	}

	/* 項目名（もちもの/バトルアイテム/わざ 等のラベル）用の縁取り付きチップ */
	.field-label {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0;
		padding: 3px 12px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--blue) 10%, white);
		border: 1.5px solid color-mix(in srgb, var(--blue) 35%, white);
		color: var(--blue);
		font-weight: 700;
		font-size: 0.78rem;
	}
</style>

<style>
	.site-header {
		display: flex;
		align-items: center;
		gap: 24px;
		padding: 16px 24px;
		background: var(--surface);
		border-bottom: 3px solid var(--blue);
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.06);
		flex-wrap: wrap;
	}

	.site-logo {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.35rem;
		text-decoration: none;
		background: linear-gradient(135deg, var(--blue), #8aa0ff);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.site-nav {
		display: flex;
		gap: 4px;
		flex-wrap: wrap;
	}

	.site-nav a {
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--ink-soft);
		padding: 6px 12px;
		border-radius: 999px;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.site-nav a:hover {
		color: var(--blue);
		background: color-mix(in srgb, var(--blue) 10%, white);
	}

	/* スマホ向けハンバーガーメニュー（PC幅では非表示）。<details>/<summary>のCSS標準機能で
	   開閉させ、JSは使わない。ボタンは画面右上に固定表示する。2026/09/03追加。 */
	.mobile-nav {
		display: none;
	}

	.mobile-nav > summary {
		list-style: none;
		position: fixed;
		top: 12px;
		right: 12px;
		z-index: 100;
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: 999px;
		box-shadow: 0 2px 8px rgba(27, 34, 51, 0.12);
		cursor: pointer;
	}

	.mobile-nav > summary::-webkit-details-marker {
		display: none;
	}

	.hamburger-icon,
	.hamburger-icon::before,
	.hamburger-icon::after {
		display: block;
		width: 20px;
		height: 2px;
		background: var(--ink);
		border-radius: 2px;
	}

	.hamburger-icon {
		position: relative;
	}

	.hamburger-icon::before,
	.hamburger-icon::after {
		content: '';
		position: absolute;
		left: 0;
	}

	.hamburger-icon::before {
		top: -6px;
	}

	.hamburger-icon::after {
		top: 6px;
	}

	.mobile-nav[open] > summary .hamburger-icon {
		background: transparent;
	}

	.mobile-nav[open] > summary .hamburger-icon::before {
		top: 0;
		transform: rotate(45deg);
	}

	.mobile-nav[open] > summary .hamburger-icon::after {
		top: 0;
		transform: rotate(-45deg);
	}

	.mobile-nav-menu {
		position: fixed;
		top: 64px;
		right: 12px;
		z-index: 99;
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 180px;
		padding: 8px;
		background: var(--surface);
		border: 1.5px solid #e5e9f2;
		border-radius: var(--radius);
		box-shadow: 0 8px 20px rgba(27, 34, 51, 0.15);
	}

	.mobile-nav-menu a {
		text-decoration: none;
		font-weight: 700;
		color: var(--ink);
		padding: 10px 12px;
		border-radius: 8px;
	}

	.mobile-nav-menu a:hover {
		color: var(--blue);
		background: color-mix(in srgb, var(--blue) 10%, white);
	}

	@media (max-width: 639px) {
		.site-nav {
			display: none;
		}

		.mobile-nav {
			display: block;
		}
	}

	main {
		max-width: 1080px;
		margin: 0 auto;
		padding: 32px 24px;
	}

	.site-footer {
		text-align: center;
		padding: 24px;
		color: var(--ink-soft);
		font-size: 0.85rem;
	}
</style>
