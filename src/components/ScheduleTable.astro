---
// 配信予定の一覧表示。日付ごとに見出しでグループ化し、各配信予定を1枚のカード行として並べる。
// カードはflex-wrapで自然に折り返すため、固定px幅のテーブルと違いスマホ幅でもはみ出さない。
// /schedule/ の配信者ブロック・広域検索セクション両方で使う。
import { detectStreamTags, type ScheduleEntry } from '../lib/schedule';

interface Props {
	entries: ScheduleEntry[];
	showChannelName?: boolean;
}

const { entries, showChannelName = false } = Astro.props;

// ビルドサーバーのタイムゾーン（本番のGitHub ActionsはUTC）に依存しないよう、
// 常に日本時間（Asia/Tokyo）で明示的にフォーマットする。
const dateLabel = (d: Date) =>
	d.toLocaleDateString('ja-JP', {
		month: 'numeric',
		day: 'numeric',
		weekday: 'short',
		timeZone: 'Asia/Tokyo',
	});
const timeLabel = (d: Date) =>
	d.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Tokyo' });

// 日付ごとにグループ化（entriesは呼び出し側で時系列ソート済みの前提）
const groups: { date: string; items: ScheduleEntry[] }[] = [];
for (const entry of entries) {
	const label = dateLabel(entry.startTime);
	const lastGroup = groups[groups.length - 1];
	if (lastGroup && lastGroup.date === label) {
		lastGroup.items.push(entry);
	} else {
		groups.push({ date: label, items: [entry] });
	}
}
---

<div class="schedule-list">
	{
		groups.map((group) => (
			<div class="date-group">
				<span class="date-heading">{group.date}</span>
				<ul class="entry-list">
					{group.items.map((entry) => (
						<li class="entry-row">
							<span class="entry-time">{timeLabel(entry.startTime)}</span>
							{showChannelName && (
								<a
									class="entry-channel"
									href={
										entry.channelId
											? `https://www.youtube.com/channel/${entry.channelId}`
											: entry.url
									}
									target="_blank"
									rel="noopener noreferrer"
								>
									{entry.channelIcon && (
										<img src={entry.channelIcon} alt="" class="channel-icon" />
									)}
									<span class="channel-name-text">{entry.channelName}</span>
								</a>
							)}
							<div class="entry-main">
								<a href={entry.url} target="_blank" rel="noopener noreferrer">
									<span class="entry-title">{entry.title}</span>
								</a>
								<div class="badge-row">
									<span class={`platform-badge platform-${entry.platform}`}>
										{entry.platform === 'twitch' ? 'Twitch' : 'YouTube'}
									</span>
									{detectStreamTags(entry.title).map((tag) => (
										<span class="field-label">{tag}</span>
									))}
								</div>
							</div>
						</li>
					))}
				</ul>
			</div>
		))
	}
</div>

<style>
	.schedule-list {
		display: flex;
		flex-direction: column;
	}

	.date-group + .date-group {
		margin-top: 20px;
	}

	.date-heading {
		display: inline-flex;
		margin-bottom: 10px;
		padding: 4px 14px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--blue) 8%, white);
		color: var(--blue);
		font-family: var(--font-number);
		font-weight: 700;
		font-size: 0.9rem;
	}

	.entry-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.entry-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 16px;
		padding: 12px 14px;
		border: 1px solid #e5e9f2;
		border-radius: var(--radius);
		background: var(--surface);
	}

	.entry-time {
		flex-shrink: 0;
		width: 52px;
		font-family: var(--font-number);
		font-weight: 700;
		color: var(--ink);
	}

	.entry-main {
		flex: 1 1 200px;
		min-width: 200px;
	}

	.entry-main > a {
		display: block;
		text-decoration: none;
		color: var(--ink);
	}

	.entry-main > a:hover .entry-title {
		text-decoration: underline;
	}

	.entry-title {
		display: block;
		overflow-wrap: anywhere;
	}

	.badge-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 6px;
	}

	.entry-channel {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		gap: 6px;
		max-width: 100%;
		color: var(--ink-soft);
		font-size: 0.85rem;
		text-decoration: none;
	}

	.entry-channel:hover .channel-name-text {
		text-decoration: underline;
	}

	.channel-icon {
		flex-shrink: 0;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		object-fit: cover;
	}

	.channel-name-text {
		overflow-wrap: anywhere;
	}

	.platform-badge {
		flex-shrink: 0;
		padding: 3px 12px;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 700;
		color: #fff;
		box-shadow: 0 2px 6px rgba(27, 34, 51, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.25);
	}

	.platform-twitch {
		background: #9146ff;
	}

	.platform-youtube {
		background: #ff0000;
	}
</style>
