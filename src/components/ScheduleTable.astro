---
// 配信予定・配信中の一覧表示。配信中(LIVE)は日付グループの上に別枠で並べ、
// 予定は日付ごとに見出しでグループ化して1枚のカード行として並べる。
// カードはflex-wrapで自然に折り返すため、固定px幅のテーブルと違いスマホ幅でもはみ出さない。
// /schedule/ の配信者ブロック・広域検索セクション両方で使う。
import ScheduleEntryRow from './ScheduleEntryRow.astro';
import type { ScheduleEntry } from '../lib/schedule';

interface Props {
	entries: ScheduleEntry[];
	liveEntries?: ScheduleEntry[];
	showChannelName?: boolean;
}

const { entries, liveEntries = [], showChannelName = false } = Astro.props;

// ビルドサーバーのタイムゾーン（本番のGitHub ActionsはUTC）に依存しないよう、
// 常に日本時間（Asia/Tokyo）で明示的にフォーマットする。
const dateLabel = (d: Date) =>
	d.toLocaleDateString('ja-JP', {
		month: 'numeric',
		day: 'numeric',
		weekday: 'short',
		timeZone: 'Asia/Tokyo',
	});

// 日付ごとにグループ化（entriesは呼び出し側で時系列ソート済みの前提）
const groups: { date: string; items: ScheduleEntry[] }[] = [];
for (const entry of entries) {
	const label = dateLabel(entry.startTime);
	const lastGroup = groups[groups.length - 1];
	if (lastGroup && lastGroup.date === label) {
		lastGroup.items.push(entry);
	} else {
		groups.push({ date: label, items: [entry] });
	}
}
---

<div class="schedule-list">
	{
		liveEntries.length > 0 && (
			<div class="live-group">
				<span class="live-heading">配信中</span>
				<ul class="entry-list">
					{liveEntries.map((entry) => (
						<ScheduleEntryRow entry={entry} showChannelName={showChannelName} />
					))}
				</ul>
			</div>
		)
	}
	{
		groups.map((group) => (
			<div class="date-group">
				<span class="date-heading">{group.date}</span>
				<ul class="entry-list">
					{group.items.map((entry) => (
						<ScheduleEntryRow entry={entry} showChannelName={showChannelName} />
					))}
				</ul>
			</div>
		))
	}
</div>

<style>
	.schedule-list {
		display: flex;
		flex-direction: column;
	}

	.live-group + .date-group,
	.date-group + .date-group {
		margin-top: 20px;
	}

	.date-heading {
		display: inline-flex;
		margin-bottom: 10px;
		padding: 4px 14px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--blue) 8%, white);
		color: var(--blue);
		font-family: var(--font-number);
		font-weight: 700;
		font-size: 0.9rem;
	}

	.live-heading {
		display: inline-flex;
		margin-bottom: 10px;
		padding: 4px 14px;
		border-radius: 999px;
		background: color-mix(in srgb, #e6484f 10%, white);
		color: #e6484f;
		font-weight: 700;
		font-size: 0.9rem;
	}

	.entry-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
</style>
